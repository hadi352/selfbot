# =====================================================================
# Telegram Selfbot — نمونه‌ی متغیرهای محیطی
# این فایل را به «.env» کپی کن (یا روی Railway در Variables ست کن) و
# مقادیر واقعی را بده. هیچ Secret واقعی‌ای داخلِ کد یا این فایل نیست.
# =====================================================================

# --- تلگرام (ضروری) ---
# از my.telegram.org → API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
# خروجیِ `python generate_session.py` (StringSession) — امن‌ترین روش برای Railway
SESSION_STRING=
# اختیاری: باتِ BotFather برای نمایشِ پنلِ دکمه‌ای (`.پنل`). خالی = پنل فقط راهنما می‌دهد
BOT_TOKEN=

# --- پایگاه داده (ضروری) ---
# روی Railway: Plugin پستگرس اضافه کن؛ DATABASE_URL خودکار ست می‌شود
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- عمومی ---
PREFIX=.
# اختلافِ زمانیِ محلی با UTC (پیش‌فرض: تهران = 3.5)
TIMEZONE_OFFSET=3.5

# --- هوش مصنوعی (اختیاری؛ خالی = قابلیت‌های AI فقط راهنما می‌دهند) ---
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# AI Router (اختیاری): مدلِ سریع/کدنویسی/استدلال — خالی = همه با AI_MODEL
AI_MODEL_FAST=
AI_MODEL_CODING=
AI_MODEL_REASONING=
# برای صوت (.رونویسی/.متن‌به‌صوت) اگر سرویسِ واسطِ تو endpoint صوتی ندارد،
# کلیدِ جدا بده؛ خالی = همان AI_API_KEY/AI_API_BASE
AI_AUDIO_API_KEY=
AI_AUDIO_API_BASE=

# جستجوی معنایی در پیام‌ها (.پرسش درباره‌ی گفتگوهای قبلی / .پیام‌یاب / .ایندکس)
# پیش‌فرض: همان AI_API_KEY/AI_API_BASE. اگر سرویسِ واسطِ تو endpointِ /embeddings ندارد،
# این دو را جدا بده (خالی بماند = همان کلید/آدرسِ بالا)
# AI_EMBED_API_KEY=
# AI_EMBED_API_BASE=
# AI_EMBED_MODEL=text-embedding-3-small
# AI_EMBED_DIMENSIONS=512
# SEMANTIC_MAX_INDEX=50000
# SEMANTIC_MIN_SCORE=0.27
# نتیجه‌ی جستجو پیش‌فرض توی «پیام‌های ذخیره‌شده» می‌آید؛ true = همان‌جا که دستور زدی
# SEMANTIC_REPLY_IN_PLACE=false

# --- پلاگین‌ها (اختیاری) ---
# پوشه‌ی پلاگین‌های نصب‌شده در زمان اجرا — روی Railway به یک Volume اشاره بده
# تا با هر دیپلوی پلاگین‌ها از بین نروند (مثلاً /data/plugins)
PLUGIN_INSTALL_DIR=plugins_installed
PLUGIN_MAX_BYTES=524288

# --- ذخیره‌سازی (اختیاری؛ فقط برای بکاپ/مهاجرتِ JSON قدیمی) ---
NOTES_FILE=notes.json
AUTOPOST_FILE=autopost.json
ASSISTANT_FILE=assistant.json
FONT_STATE_FILE=font_state.json
STATS_FILE=stats.json

# --- PostgreSQL (اختیاری — تنظیماتِ pool) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# کپی کانال (.کپی‌کانال) — مقادیرِ محافظه‌کارانه؛ بالاتر بردنشون ریسکِ FloodWait/محدودیتِ اکانت داره
# CHANNEL_COPY_BATCH_SIZE=20
# CHANNEL_COPY_DELAY_SECONDS=8
# CHANNEL_COPY_DAILY_LIMIT=0   # ۰ = بدونِ سقفِ روزانه
